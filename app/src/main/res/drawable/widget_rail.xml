<?xml version="1.0" encoding="utf-8"?>
<!--
    The bar down the left of the widget. The three colours the app watches with, in order, and
    it is there whether or not anything is due: with nothing waiting this and the chips are the
    only colour on screen, and an empty widget is what you look at most of the time.

    Rounded and inset rather than flush to the edge, because a RemoteViews child cannot be
    clipped to the rounded corners of its parent, and a square bar in a round corner looks like
    a mistake.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/widget_leave"
        android:endColor="@color/widget_bill"
        android:startColor="@color/widget_reply"
        android:type="linear" />
    <corners android:radius="2dp" />
</shape>
