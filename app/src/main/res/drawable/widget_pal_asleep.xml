<?xml version="1.0" encoding="utf-8"?>
<!--
    Not walking: sat down, wider and lower, feet tucked away, eye a closed line.

    This is the pose for "not watching". It is deliberately not amber: amber in this app means
    something is waiting on you, and a permission that was never granted is the app being
    switched off, not a thing to answer. The stillness is the signal.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- body: 26 x 22, squat and low -->
    <item
        android:bottom="8dp"
        android:left="7dp"
        android:right="7dp"
        android:top="10dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_dim" />
        </shape>
    </item>

    <!-- closed eye: 6 x 2 -->
    <item
        android:bottom="18dp"
        android:left="20dp"
        android:right="14dp"
        android:top="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_bg" />
        </shape>
    </item>
</layer-list>
