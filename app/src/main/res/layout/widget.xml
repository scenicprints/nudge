<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget. Both headlines are declared and the code shows one, so that the amber and the
    grey each come from a colour resource with a night variant rather than being resolved at
    runtime against the wrong configuration.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/headline_now"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:text="@string/widget_waiting"
        android:textColor="@color/widget_now"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/headline_calm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_calm"
        android:textColor="@color/widget_dim"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textColor="@color/widget_dim"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
